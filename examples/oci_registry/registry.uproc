// The OCI registry's dispatch. README.md has the rationale.
module oci.registry {

  // An HTTP request HEAD, as the relay maps it: `xid` is the 14-byte exchange
  // id wave's `http` chose, which every record of the exchange carries and the
  // answer comes back under; `method` and `path` are the HEAD's method and
  // target.
  message oci.Request {
    xid: bytes = 1;
    method: int = 2;
    path: string = 3;
  }

  // What storage is asked: the same exchange, rewritten. `key` is the object
  // in the registry bucket — the path verbatim, since an object key is opaque
  // bytes and needs no parsing.
  message oci.S3Call {
    xid: bytes = 1;
    method: int = 2;
    key: string = 3;
  }

  enum GET = 1;   // the exchange contract's method codes
  enum HEAD = 4;

  // Method → storage request. Every path is a key, `/v2/` included:
  // discovery is a seeded object, not a branch, so the chain never forks.
  // The registry serves reads, so anything but GET is asked as a HEAD.
  decision to_s3(req: oci.Request) -> oci.S3Call {
    when req.method == GET ->
      oci.S3Call { xid: req.xid, method: GET, key: "/registry" + req.path };
    default ->
      oci.S3Call { xid: req.xid, method: HEAD, key: "/registry" + req.path };
  }

  pipeline serve(req: oci.Request) -> oci.S3Call {
    call routed = to_s3(req);
    return routed;
  }

  entry serve = serve;

  provenance revision "oci-v2-read-path" toolchain "chronicle";
}

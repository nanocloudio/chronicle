// A pipeline whose compute run is SPLIT by a decision — the shape that produces
// more than one node of the same kind.
//
// The VM cannot branch, so a decision is always its own node and always breaks
// the surrounding compute run. That yields `pipeline`, `decision`, `pipeline2`,
// and `pipeline2`'s instance name does not imply its module type: the node must
// carry an explicit `type: pipeline`, or fluxor resolves a module named
// `pipeline2` and refuses the graph. tools/e2e/graph.sh lowers this document and
// loads the result, which only a real graph can prove.
//
// Effect-free, so `chronicle graph` can lower it with nothing supplied from
// outside.
module t.split {

  message t.Item {
    id: string = 1;
    n: int = 2;
  }

  transformation bump(a: t.Item) -> t.Item {
    t.Item { id: a.id, n: a.n + 1 }
  }

  decision classify(a: t.Item) -> t.Item {
    when a.n >= 10 -> t.Item { id: a.id, n: 1 };
    default -> t.Item { id: a.id, n: 0 };
  }

  pipeline process(a: t.Item) -> t.Item {
    call first = bump(a);
    call sorted = classify(a);
    call second = bump(a);
    return second;
  }

  entry process = process;

  provenance revision "example" toolchain "chronicle";
}
